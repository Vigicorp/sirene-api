{
    "name": "vigicorp/sirene-api",
    "description": "",
    "keywords": [
        "swagger",
        "php",
        "sdk",
        "api",
        "sirene"
    ],
    "homepage": "https://github.com/Vigicorp/sirene-api",
    "license": "MIT",
    "authors": [
        {
            "name": "PastisD",
            "homepage": "https://github.com/PastisD"
        }
    ],
    "require": {
        "php": "^7.4 || ^8.0",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.3",
        "guzzlehttp/psr7": "^1.7 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^4.8",
        "squizlabs/php_codesniffer": "~2.6",
        "friendsofphp/php-cs-fixer": "~2.12"
    },
    "autoload": {
        "psr-4": { "Sirene\\Client\\" : "lib/" }
    },
    "autoload-dev": {
        "psr-4": { "Sirene\\Client\\" : "test/" }
    }
}
